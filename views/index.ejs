<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>
    <%- include('navBar') -%>
    <h1>Messages</h1>
    <% messages.forEach((message, index) => { %>
        <h2>Message <%= index + 1 %></h2>
        <p>Sender: <%= message.user %></p>
        <p>Message: <%= message.text %></p>
        <p>Time: <%= message.added %></p>
        <a href="/messages/<%= index + 1 %>">Open message</a>
    <%})%>
</body>
</html>